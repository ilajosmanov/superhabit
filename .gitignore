# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
coverage/
.vite/
.vite-task/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo


# generated native folders
/ios
/android

# local native modules: build output
modules/*/android/build/
modules/*/android/.cxx/

# kotlin-language-server cache
kls_database.db

# verification evidence (verify-superhabit skill)
.verify/

# real pose traces from public datasets (licences vary; local only)
src/exercises/__fixtures__/traces/
*.env

# generated by `wrangler types`; the server typecheck makes it
server/worker-configuration.d.ts
server/.wrangler/
# the Worker's local secrets (`wrangler dev`); the example names them
server/.dev.vars*
!server/.dev.vars.example
