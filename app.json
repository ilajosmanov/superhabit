{
  "expo": {
    "name": "superhabit",
    "slug": "superhabit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "superhabit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0e0b",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Superhabit uses the camera to count your reps and check your form."
      },
      "bundleIdentifier": "com.ilajosmanov.superhabit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0e0b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ilajosmanov.superhabit",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0e0b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.2.10"
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Geist.ttf",
              "./assets/fonts/GeistMono.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "path": "./assets/fonts/Geist.ttf",
                "fontDefinitions": [
                  {
                    "weight": 200
                  },
                  {
                    "weight": 300
                  },
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  },
                  {
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Geist Mono",
                "path": "./assets/fonts/GeistMono.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
