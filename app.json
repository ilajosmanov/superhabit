{
  "expo": {
    "name": "RepRepGo",
    "slug": "reprepgo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reprepgo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d0e0b",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "RepRepGo uses the camera to count your reps and check your form.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "bundleIdentifier": "app.reprepgo"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0d0e0b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.reprepgo",
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0e0b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.2.10"
          },
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": ["./assets/fonts/Geist.ttf", "./assets/fonts/GeistMono.ttf"]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "path": "./assets/fonts/Geist.ttf",
                "fontDefinitions": [
                  {
                    "weight": 200
                  },
                  {
                    "weight": 300
                  },
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  },
                  {
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Geist Mono",
                "path": "./assets/fonts/GeistMono.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-web-browser",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.408762936395-7elgs938chpm5fiurtm07j87jdaq2r3c"
        }
      ],
      "./plugins/backup-rules.js",
      "./plugins/mediapipe-gtm.js",
      "./plugins/sentry-gradle-order.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "reprepgo",
          "project": "reprepgo-app",
          "experimental_android": {
            "enableAndroidGradlePlugin": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
