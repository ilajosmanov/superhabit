{
  "expo": {
    "name": "superhabit",
    "slug": "superhabit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "superhabit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Superhabit uses the camera to count your reps and check your form."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.superhabit",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": ["./assets/fonts/Geist.ttf", "./assets/fonts/GeistMono.ttf"]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "path": "./assets/fonts/Geist.ttf",
                "fontDefinitions": [
                  {
                    "weight": 200
                  },
                  {
                    "weight": 300
                  },
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Geist Mono",
                "path": "./assets/fonts/GeistMono.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
